{
  "manifest_version": 3,
  "name": "Tidy Bookmarks",
  "version": "1.0.0",
  "description": "Find duplicate bookmarks, empty folders and broken links. Everything stays in your browser.",
  "homepage_url": "https://github.com/nidobyte/tidy-bookmarks",
  "permissions": [
    "bookmarks"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tidy Bookmarks",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
